{
  "name": "desktop",
  "version": "0.1.0",
  "description": "AnlinetDB Desktop - Electron + Next.js",
  "author": "ZITZ-bit",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "package": "electron-builder --win"
  },
  "dependencies": {
    "boxicons": "^2.1.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.anlinetdb.desktop",
    "productName": "AnlinetDB",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../lib/",
        "to": "lib/",
        "filter": ["**/*"]
      }
    ],
    "asar": false,
    "win": {
      "target": ["nsis", "zip"],
      "icon": "../lib/assets/icons/icon.ico",
      "signingHashAlgorithms": ["sha256"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallDirectory": true,
      "createDesktopShortcut": true,
      "createUninstaller": true,
      "shortcutName": "AnlinetDB"
    },
    "publish": "never"
  }
}
