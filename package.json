{
  "name": "anlinetdb",
  "version": "1.0.0",
  "description": "Monorepo para AnlinetDB - Electron + NestJS + Next.js",
  "private": true,
  "packageManager": "npm@12.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "npm run setup --workspace=api",
    "postinstall": "npm run setup --workspace=api",
    "dev": "turbo run dev",
    "dev:develop": "turbo run dev:develop",
    "dev:desktop": "turbo run dev --filter=desktop",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "package": "turbo run package",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
