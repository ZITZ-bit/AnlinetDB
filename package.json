{
  "name": "anlinetdb",
  "version": "1.0.0",
  "description": "Monorepo para AnlinetDB - Electron + NestJS + Next.js",
  "private": true,
  "packageManager": "npm@12.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",

    "dev:desktop": "turbo run dev --filter=desktop",
    "dev:api": "turbo run dev --filter=api",
    
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  }
}
